.overlay { position: absolute; left: 0; right: 0; top: 0; bottom: 0; align-items: center; justify-content: center; background-color: rgba(12, 10, 20, 0.85); }
.card { width: 460px; max-width: 94%; padding: 28px 36px 22px 36px; background-color: rgb(31, 27, 42); border-width: 1px; border-color: rgb(151, 121, 75); border-radius: 8px; color: rgb(243, 233, 211); }
.brand { -unity-text-align: middle-center; font-size: 13px; color: rgb(210, 176, 116); }
.rule { height: 1px; margin: 16px 70px; background-color: rgb(116, 93, 65); }
.title { font-size: 30px; -unity-font-style: bold; -unity-text-align: middle-center; }
.subtitle { font-size: 13px; color: rgb(177, 168, 186); -unity-text-align: middle-center; margin-top: 6px; margin-bottom: 22px; white-space: normal; }
.menu-button { height: 44px; margin: 0 0 10px 0; border-width: 1px; border-color: rgb(102, 89, 115); border-radius: 4px; background-color: rgb(43, 37, 55); color: rgb(243, 233, 211); font-size: 16px; }
.menu-button:hover { background-color: rgb(64, 53, 75); border-color: rgb(222, 190, 132); }
.menu-button:focus { border-width: 2px; border-color: rgb(246, 219, 164); }
.menu-button:active { background-color: rgb(85, 68, 91); }
.primary { background-color: rgb(208, 174, 115); color: rgb(31, 25, 35); border-color: rgb(226, 195, 142); -unity-font-style: bold; }
.primary:hover { background-color: rgb(235, 206, 155); }
.primary:active { background-color: rgb(180, 145, 92); }
.volume-heading { flex-direction: row; justify-content: space-between; margin-top: 12px; }
.volume-label { font-size: 11px; color: rgb(185, 174, 195); }
.volume-value { font-size: 13px; color: rgb(226, 195, 142); }
.volume-slider { height: 28px; margin: 5px 0 20px 0; }
.volume-slider #unity-tracker { height: 4px; background-color: rgb(102, 89, 115); border-width: 0; }
.volume-slider #unity-dragger { background-color: rgb(226, 195, 142); border-color: rgb(246, 219, 164); width: 16px; height: 16px; border-radius: 8px; margin-top: -6px; }
.volume-slider:focus #unity-dragger { border-width: 2px; border-color: white; }
.quit { background-color: rgba(0, 0, 0, 0); color: rgb(202, 179, 183); }
.status { min-height: 20px; font-size: 12px; color: rgb(235, 187, 152); white-space: normal; -unity-text-align: middle-center; }
.hint { margin-top: 8px; font-size: 10px; -unity-text-align: middle-center; color: rgb(157, 145, 169); }
